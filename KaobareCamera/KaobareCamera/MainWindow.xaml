<Window x:Class="KaobareCamera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KaobareCamera"
        mc:Ignorable="d"
        Title="Kao-Bare Camera" Height="480" Width="720" MinHeight="80" MinWidth="120"
        AllowsTransparency="True" UseLayoutRounding="True" Topmost="True" WindowStyle="None" Background="Transparent">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="終了 (_X)" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.DataContext>
        <local:AppModel d:IsInDesignMode="True"/>
    </Window.DataContext>
    <Grid>
        <Image Source="{Binding Bitmap}"/>
    </Grid>
</Window>
